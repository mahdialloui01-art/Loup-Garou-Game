config_version=5

[application]
config/name="Castle Destroyer"
config/icon="res://castle_icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/description="A mobile castle siege game with enhanced 3D lighting and destructible walls."

[display]
window/handheld/orientation=0
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=16
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.10, 1)

[physics]
3d/physics_engine="Jolt Physics"

[editor_plugins]
enabled=PackedStringArray("res://addons/castle_destruction/plugin.cfg")
